{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.stock.receive",
  "description": "Input del handler WASM receive_stock: recepción de mercancía (cap 200). Cada línea trae product_id (el SDK/host resuelve sku→id antes) y qty > 0 (decimales OK — #10); unit_cost opcional actualiza el coste. `reference` (albarán) viaja al movimiento `reception` (#7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "qty"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit_cost": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "default": null
          }
        }
      }
    },
    "reference": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "maxLength": 200
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  }
}
