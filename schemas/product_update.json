{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.products.update",
  "description": "Edición de producto (la UI envía el conjunto completo de campos editables).",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "name", "price", "cost", "low_stock_threshold", "is_active"],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "price": { "type": "number", "minimum": 0 },
    "cost": { "type": "number", "minimum": 0 },
    "low_stock_threshold": { "type": "integer", "minimum": 0 },
    "tax_category_key": { "type": ["string", "null"], "default": null },
    "is_active": { "type": "integer", "enum": [0, 1] }
  }
}
