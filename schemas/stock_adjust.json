{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.stock.adjust",
  "description": "Ajuste de stock por delta (puede ser negativo; el SQL no baja de 0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "delta"],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "delta": { "type": "integer" }
  }
}
