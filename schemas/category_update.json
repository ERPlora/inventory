{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.categories.update",
  "type": "object",
  "additionalProperties": false,
  "required": ["category_id", "name"],
  "properties": {
    "category_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "slug": { "type": "string", "default": "", "maxLength": 120 },
    "icon": { "type": "string", "default": "cube-outline", "maxLength": 50 },
    "color": { "type": "string", "default": "#3880ff", "maxLength": 20 },
    "description": { "type": "string", "default": "" },
    "order": { "type": "integer", "minimum": 0, "default": 0 },
    "tax_rate_id": { "type": ["string", "null"], "default": null },
    "is_active": { "type": "integer", "enum": [0, 1], "default": 1 }
  }
}
