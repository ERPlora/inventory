{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.categories.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "slug": { "type": "string", "default": "", "maxLength": 120 },
    "icon": { "type": "string", "default": "cube-outline", "maxLength": 50 },
    "color": { "type": "string", "default": "#3880ff", "maxLength": 20 },
    "description": { "type": "string", "default": "" },
    "order": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
