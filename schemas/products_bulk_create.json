{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.products.bulk_create",
  "description": "Input del handler WASM bulk_create: alta batch de productos (cap 100). El sku se autogenera (PROD-NNN desde existing_count) si la línea no lo trae.",
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sku": { "type": "string", "default": "", "maxLength": 100 },
          "ean13": { "type": ["string", "null"], "default": null, "maxLength": 13 },
          "description": { "type": "string", "default": "" },
          "product_type": { "type": "string", "enum": ["physical", "service"], "default": "physical" },
          "price": { "type": "integer", "minimum": 0, "default": 0 },
          "cost": { "type": "integer", "minimum": 0, "default": 0 },
          "stock": { "type": "integer", "minimum": 0, "default": 0 },
          "low_stock_threshold": { "type": "integer", "minimum": 0, "default": 10 },
          "tax_category_key": { "type": ["string", "null"], "default": null },
          "image": { "type": "string", "default": "" }
        }
      }
    },
    "existing_count": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
