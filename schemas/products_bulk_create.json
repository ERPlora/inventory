{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.products.bulk_create",
  "description": "Input del handler WASM bulk_create: alta batch de productos (cap 100). El sku se autogenera (PROD-NNN desde existing_count) si la línea no lo trae.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sku": {
            "type": "string",
            "default": "",
            "maxLength": 100
          },
          "ean13": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "maxLength": 13
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "product_type": {
            "type": "string",
            "enum": [
              "physical",
              "service"
            ],
            "default": "physical"
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "low_stock_threshold": {
            "type": "integer",
            "minimum": 0,
            "default": 10
          },
          "tax_category_key": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "image": {
            "type": "string",
            "default": ""
          }
        }
      }
    },
    "existing_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "unit_code": {
      "description": "Unidad base de inventario del producto (ADR-0147). Los movimientos se convierten y almacenan en ella. `ud` por defecto: el caso mayoritario no obliga a declarar nada.",
      "type": "string",
      "default": "ud",
      "maxLength": 8
    },
    "price_quantity_value": {
      "description": "Cantidad de precio en escala 10⁶ (modelo KPEIN). «0,37 € por 100 ud» se expresa con price=37 y price_quantity_value=100000000, y así un precio sub-céntimo NO mete decimales en el dinero.",
      "type": "integer",
      "minimum": 1,
      "default": 1000000
    },
    "pricing_unit_code": {
      "description": "Unidad a la que se refiere el precio. Puede diferir de la unidad base (precio por kg, stock en g).",
      "type": "string",
      "default": "ud",
      "maxLength": 8
    }
  }
}
